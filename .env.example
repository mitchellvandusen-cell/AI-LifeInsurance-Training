# ══════════════════════════════════════════════════════════════
# InsuranceGrokBot Training Platform — Environment Variables
# Copy this to .env and fill in your values
# ══════════════════════════════════════════════════════════════

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/dbname?sslmode=require

# xAI API Key (powers both Grok LLM and Voice Agent)
XAI_API_KEY=xai-...

# JWT Secret (generate a random string)
JWT_SECRET=change-me-to-a-secure-random-string

# Stripe Billing
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ADDON_2HR=price_...
STRIPE_PRICE_ADDON_4HR=price_...

# Application
APP_URL=https://your-domain.com
HOST=0.0.0.0
PORT=8000
DEBUG=false

# LLM Model (optional, defaults to grok4-1-fast-reasoning)
LLM_MODEL=grok4-1-fast-reasoning
